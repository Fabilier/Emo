# Copier en .env (ignoré par git) et remplir la clé.
# POC : Gemini (palier gratuit, ne pas envoyer de données personnelles)
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash
# Bascule Mistral : LLM_BASE_URL=https://api.mistral.ai/v1  LLM_MODEL=mistral-small-latest
# Voix locale (piper) et transcription locale (faster-whisper)
PIPER_BIN=piper
PIPER_VOICE=/home/pi/piper/fr_FR-siwis-medium.onnx
WHISPER_MODEL=tiny
